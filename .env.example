DOMAIN=multicon-w.com
NODE_ENV=production
PORT=3000

# ---------- App ----------
# APP_URL=http://localhost
APP_URL=https://multicon-w.com
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# ---------- First admin (seeded on startup if no admin exists) ----------
ADMIN_LOGIN_ID=admin
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_ADMIN_PASSWORD

# ---------- MongoDB (private network only) ----------
MONGO_ROOT_USER=REPLACE_WITH_MONGO_ROOT_USER
MONGO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_MONGO_PASSWORD
MONGODB_URI=mongodb://USER:PASSWORD@mongo:27017/multiconw?authSource=admin

# ---------- SeaweedFS S3 (local Docker container: seaweedfs) ----------
S3_ENDPOINT=http://minio:8333
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
S3_BUCKET=my-pdfs
S3_REGION=us-east-1
